# Root .gitignore for frontend (Vite/React) and backend (FastAPI/Python)

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Node / Vite
node_modules/
dist/
dist-ssr/
*.local
*.tsbuildinfo
*.map
.npmrc
.pnpm-store/
node_modules/.vite/
frontend/dist/
frontend/.vite/
frontend/.cache/

# Python / FastAPI
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
.eggs/
build/
dist/
.mypy_cache/
.pytest_cache/
.coverage*
coverage/
coverage.xml
htmlcov/
.ruff_cache/
.pytype/
.tox/
.python-version

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment / Secrets
.env
*.env
*.env.*
!**/.env.example

# OS / Editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Misc
.cache/
.tailwind/
.eslintcache

# Lockfiles: keep whichever PM you use; do NOT ignore them generally.
# If you never use pnpm, you may re-add pnpm-lock.yaml to ignore.
# pnpm-lock.yaml